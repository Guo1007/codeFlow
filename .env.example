# ========== 必填 ==========
# 大模型 API Key（与 application.yaml 的 CODE_FLOW_KEY 对应，阿里云百炼 dashscope）
CODE_FLOW_KEY=sk-your-api-key-here

# 知识库向量模型 API Key（阿里云百炼 dashscope，见 langchain4j.open-ai.embedding-model）
# 可与 CODE_FLOW_KEY 相同；若对话模型已切 deepseek，此处仍需一个有效的百炼 key 供 embedding 使用
EMBEDDING_KEY=sk-your-embedding-key-here

# ========== MySQL ==========
MYSQL_ROOT_PASSWORD=root