# ========== 阶段1: 构建 ==========
FROM maven:3.9-eclipse-temurin-17 AS builder
WORKDIR /build

# 配置 Maven 国内镜像加速（腾讯云，较稳定）
RUN mkdir -p /root/.m2 && \
    echo '<?xml version="1.0" encoding="UTF-8"?>\
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">\
  <mirrors>\
    <mirror>\
      <id>tencent</id>\
      <mirrorOf>central</mirrorOf>\
      <name>Tencent Maven</name>\
      <url>https://mirrors.cloud.tencent.com/nexus/repository/maven-public/</url>\
    </mirror>\
  </mirrors>\
</settings>' > /root/.m2/settings.xml

# 先复制 pom.xml，利用 Docker 缓存机制加速依赖下载
COPY pom.xml .
# 预下载依赖；镜像源偶发 502，最多重试 3 次
RUN for i in 1 2 3; do \
        mvn dependency:go-offline -B -U && exit 0; \
        echo "依赖下载失败(第${i}次)，10秒后重试..."; \
        sleep 10; \
    done; \
    exit 1

# 复制源码并打包（跳过测试）；失败最多重试 3 次兜底
COPY src ./src
RUN for i in 1 2 3; do \
        mvn package -DskipTests -B -U && exit 0; \
        echo "打包/依赖下载失败(第${i}次)，10秒后重试..."; \
        sleep 10; \
    done; \
    exit 1

# ========== 阶段2: 运行 ==========
FROM eclipse-temurin:17-jre
WORKDIR /app

COPY --from=builder /build/target/*.jar app.jar

# 暴露端口（与 application.yaml server.port 保持一致，当前为 1007）
EXPOSE 1007

# JVM 参数优化（2G 服务器）
ENV JAVA_OPTS="-Xms128m -Xmx256m -XX:+UseSerialGC"

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]